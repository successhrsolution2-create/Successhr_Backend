NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5175
# Production example:
# CLIENT_URL=https://app.successhrsolutions.com,https://apply.successhrsolutions.com,https://attendance.successhrsolutions.com
# ALLOWED_ORIGIN=
TRUST_PROXY_HOPS=1

MONGODB_URI=mongodb://127.0.0.1:27017/successhr
# Optional: use when a mongodb+srv Atlas URI fails because local Node DNS cannot resolve SRV records.
MONGODB_SRV_FALLBACK_HOSTS=
MONGODB_SRV_FALLBACK_OPTIONS=tls=true&replicaSet=your-replica-set&authSource=admin
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_MS=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_COMPRESSORS=zlib

API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100

JWT_SECRET=replace_with_at_least_32_random_characters
CRM_JWT_SECRET=replace_with_at_least_32_random_characters
EMS_JWT_SECRET=replace_with_at_least_32_random_characters
EMS_REFRESH_SECRET=replace_with_at_least_32_random_characters
COMPANY_ADMIN_JWT_SECRET=replace_with_at_least_32_random_characters
BACKUP_JWT_SECRET=replace_with_at_least_32_random_characters
BACKUP_DOWNLOAD_SECRET=replace_with_at_least_32_random_characters

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_PARAMETER_PREFIX=/successhr/dev
AWS_PARAMETER_NAMES=MONGODB_URI,JWT_SECRET,CRM_JWT_SECRET,EMS_JWT_SECRET,EMS_REFRESH_SECRET,COMPANY_ADMIN_JWT_SECRET,BACKUP_JWT_SECRET,BACKUP_DOWNLOAD_SECRET,UPSTASH_REDIS_REST_URL,UPSTASH_REDIS_REST_TOKEN

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
